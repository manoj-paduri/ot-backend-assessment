{
  "Urls": "http://localhost:5000",
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "OtAssessmentDb": "Server=localhost;Database=OT_Assessment_DB;Integrated Security=SSPI;TrustServerCertificate=True;"
  },
  "Database": {
    "CommandTimeoutSeconds": 30
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ClientName": "ot-assessment-api",
    "QueueName": "ot.assessment.wagers",
    "DeadLetterExchangeName": "ot.assessment.wagers.dlx",
    "DeadLetterQueueName": "ot.assessment.wagers.dead",
    "PublisherChannelPoolSize": 16
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "ot-assessment:"
  },
  "Caching": {
    "TopSpendersTtlSeconds": 5
  }
}
