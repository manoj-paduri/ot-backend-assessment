{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "OtAssessmentDb": "Server=localhost;Database=OT_Assessment_DB;Integrated Security=SSPI;TrustServerCertificate=True;"
  },
  "Database": {
    "CommandTimeoutSeconds": 60
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ClientName": "ot-assessment-consumer",
    "QueueName": "ot.assessment.wagers",
    "DeadLetterExchangeName": "ot.assessment.wagers.dlx",
    "DeadLetterQueueName": "ot.assessment.wagers.dead"
  },
  "Consumer": {
    "BatchSize": 500,
    "BatchMaxWaitMilliseconds": 200,
    "PrefetchCount": 1000,
    "RetryInitialDelayMilliseconds": 500,
    "RetryMaxDelayMilliseconds": 15000,
    "ReconnectDelayMilliseconds": 5000
  }
}
